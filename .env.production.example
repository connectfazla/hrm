# ── Database ──
DB_USER=uppearance
DB_PASSWORD=change-me-strong-password
DB_NAME=uppearance_hrms
DATABASE_URL=postgresql://uppearance:change-me-strong-password@postgres:5432/uppearance_hrms

# ── JWT (generate with: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
REFRESH_IDLE_TTL_HOURS=2

# ── File encryption (generate with: openssl rand -base64 32) ──
FILES_MASTER_KEY=change-me-encryption-key

# ── SMTP (production email service) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=smtp-password

# ── CORS ──
CORS_ORIGIN=https://yourdomain.com

# ── Registration (public /register) ──
# Code "upp" (or REGISTRATION_CODE_EMPLOYEE) → EMPLOYEE; "darkk" (or REGISTRATION_CODE_ADMIN) → ADMIN.
REGISTRATION_CODE_EMPLOYEE=upp
REGISTRATION_CODE_ADMIN=darkk

# Web URL for password-reset links (API)
APP_BASE_URL=https://yourdomain.com

# ── Public API URL (used at build-time for Next.js) ──
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# ── Ports ──
API_PORT=4000
WEB_PORT=3000
